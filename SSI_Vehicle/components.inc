/**
 * # Functions
 */

/**
 * @brief      Whether a number is a vehicle model.
 *
 * @param      modelid  Number to check.
 *
 * @return     - `true` it is 400 to 611
 *             - `false` it is not
 */
forward bool:IsValidVehicleModel(modelid);

/**
 * @brief      Whether a number is a tuning component.
 *
 * @param      componentid  Number to check.
 *
 * @return     - `true` it is 1000 to 1193
 *             - `false` it is not
 */
forward bool:IsValidVehicleComponent(componentid);

/**
 * @brief      The name of a component type.
 *
 * Includes `COMPONENT_TYPE_COLORS` and `COMPONENT_TYPE_PAINT_JOBS`, which a
 * modshop menu lists with the real types.
 *
 * @param      type  `COMPONENT_TYPE_VENTS` to `COMPONENT_TYPE_PAINT_JOBS`.
 * @param      name  Reads back the name.
 * @param      size  Size of `name`.
 *
 * @return     - `true` the name was written
 *             - `false` `type` is out of range
 */
forward bool:GetVehicleComponentTypeName(type, name[], size = sizeof (name));

/**
 * @brief      The type a component is fitted as.
 *
 * A `COMPONENT_TYPE_*` of this library, not the `CARMODTYPE` of the native
 * `GetVehicleComponentType`.
 *
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - the type
 *             - `COMPONENT_TYPE_NONE` when:
 *                 + `componentid` is out of range
 *                 + it is the second half of a pair
 */
forward GetVehicleComponentTypeID(componentid);

/**
 * @brief      The price of a component in a shop.
 *
 * A pair is priced once, on the half a menu offers.
 *
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - the price
 *             - `0` when:
 *                 + `componentid` is out of range
 *                 + it is the second half of a pair
 */
forward GetVehicleComponentCost(componentid);

/**
 * @brief      The other half of a two piece component.
 *
 * Sideskirts and vents come in left and right halves, fitted together.
 *
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - the other half
 *             - `INVALID_VEHICLE_COMPONENT_ID` when:
 *                 + `componentid` is out of range
 *                 + it is fitted on its own
 */
forward GetVehicleComponentPair(componentid);

/**
 * @brief      Which shop sells a component.
 *
 * Not which cars take it, which `CanVehicleModelHaveComponent` answers.
 *
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - `COMPONENT_AVAILABILITY_MOST` most cars, planes and helicopters
 *             - `COMPONENT_AVAILABILITY_TRANSFENDER` some Transfender cars
 *             - `COMPONENT_AVAILABILITY_EXCLUSIVE` a part made for one car,
 *               which `GetVehicleComponentExclusiveModel` gives
 *             - `COMPONENT_AVAILABILITY_NONE` when:
 *                 + `componentid` is out of range
 *                 + it is the second half of a pair
 */
forward GetVehicleComponentAvailability(componentid);

/**
 * @brief      The car a component was made for, if it was made for one.
 *
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - a vehicle model, 400 to 611
 *             - `INVALID_VEHICLE_MODEL_ID` when:
 *                 + `componentid` is out of range
 *                 + it is sold for most cars or at Transfender
 */
forward GetVehicleComponentExclusiveModel(componentid);

/**
 * @brief      The name of a component, as the shop lists it.
 *
 * The second half of a pair has no name, so pass an id from
 * `GetVehicleComponentInSlot` through `GetVehicleComponentPrimary` first.
 *
 * @param      componentid  Component, 1000 to 1193.
 * @param      name         Reads back the name.
 * @param      size         Size of `name`.
 *
 * @return     - `true` the name was written
 *             - `false` `componentid` is out of range
 */
forward bool:GetVehicleComponentName(componentid, name[], size = sizeof (name));

/**
 * @brief      Whether a vehicle model takes a component.
 *
 * This is what the game accepts, which is more than the shops sell: nitro,
 * wheels and hydraulics also go on aircraft and boats.
 *
 * @param      modelid      Vehicle model, 400 to 611.
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - `true` the model takes it
 *             - `false` when:
 *                 + `modelid` is out of range
 *                 + `componentid` is out of range
 *                 + it does not fit that model
 */
forward bool:CanVehicleModelHaveComponent(modelid, componentid);

/**
 * @brief      The component a shop lists for any component.
 *
 * `GetVehicleComponentInSlot` can return either half of a pair, and the second
 * half has no type, name or price. A component fitted on its own is its own
 * primary.
 *
 * @param      componentid  Component, 1000 to 1193.
 *
 * @return     - the primary
 *             - `INVALID_VEHICLE_COMPONENT_ID` `componentid` is out of range
 */
forward GetVehicleComponentPrimary(componentid);

/**
 * # Component
 */

stock bool:IsValidVehicleModel(modelid) {
    return (MIN_VEHICLE_MODEL_ID <= modelid <= MAX_VEHICLE_MODEL_ID);
}

stock bool:IsValidVehicleComponent(componentid) {
    return (MIN_VEHICLE_COMPONENT_ID <= componentid <= MAX_VEHICLE_COMPONENT_ID);
}

stock bool:GetVehicleComponentTypeName(type, name[], size = sizeof (name)) {
    if (!(0 <= type < MAX_COMPONENT_TYPE_NAMES)) {
        return false;
    }

    strunpack(name, gComponentTypeName[type], size);

    return true;
}

stock GetVehicleComponentTypeID(componentid) {
    if (!IsValidVehicleComponent(componentid)) {
        return COMPONENT_TYPE_NONE;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_TYPE];
}

stock GetVehicleComponentCost(componentid) {
    if (!IsValidVehicleComponent(componentid)) {
        return 0;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_COST];
}

stock GetVehicleComponentPair(componentid) {
    if (!IsValidVehicleComponent(componentid)) {
        return INVALID_VEHICLE_COMPONENT_ID;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_PAIR];
}

stock GetVehicleComponentAvailability(componentid) {
    if (!IsValidVehicleComponent(componentid)) {
        return COMPONENT_AVAILABILITY_NONE;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_AVAILABILITY];
}

stock GetVehicleComponentExclusiveModel(componentid) {
    if (!IsValidVehicleComponent(componentid)) {
        return INVALID_VEHICLE_MODEL_ID;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_MODEL];
}

stock bool:GetVehicleComponentName(componentid, name[], size = sizeof (name)) {
    if (!IsValidVehicleComponent(componentid)) {
        return false;
    }

    strunpack(name, gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_NAME], size);

    return true;
}

stock bool:CanVehicleModelHaveComponent(modelid, componentid) {
    if (!IsValidVehicleModel(modelid)) {
        return false;
    }

    if (!IsValidVehicleComponent(componentid)) {
        return false;
    }

    new const
        index = componentid - MIN_VEHICLE_COMPONENT_ID
    ;

    return bool:((gVehicleComponents[modelid - MIN_VEHICLE_MODEL_ID][index >>> 5] >>> (index & 0b00011111)) & 1);
}

stock GetVehicleComponentPrimary(componentid) {
    if (!IsValidVehicleComponent(componentid)) {
        return INVALID_VEHICLE_COMPONENT_ID;
    }

    return gComponentPrimary[componentid - MIN_VEHICLE_COMPONENT_ID];
}
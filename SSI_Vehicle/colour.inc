/**
 * # Functions
 */

/**
 * @brief      The colour a paint of the game shows.
 *
 * @param      paint  The paint, as `ChangeVehicleColours` takes it.
 *
 * @return     - its RGBA
 *             - `0` it is not below `MAX_VEHICLE_PAINT`
 */
forward GetVehiclePaintRGBA(paint);

stock GetVehiclePaintRGBA(paint) {
    return (0 <= paint < MAX_VEHICLE_PAINT) ? gVehiclePaint[paint] : 0;
}
